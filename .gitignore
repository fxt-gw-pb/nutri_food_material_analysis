# 依赖
node_modules

# 本地环境变量（含真正的密钥，如千问 API Key —— 仅用于云函数/后端）
.env
.env.local

# 微信开发者工具本地/私有配置（含本地编译设置）
project.private.config.json

# TypeScript 编译产物（DevTools 内置 TS 插件会就地生成 .js，不应提交）
miniprogram/**/*.js
miniprogram/**/*.js.map
!miniprogram/**/*.config.js

# 小程序 npm 构建产物
miniprogram_npm/

# 云函数依赖
cloudfunctions/**/node_modules/

# 系统与编辑器
.DS_Store
.idea/
.vscode/
*.log
