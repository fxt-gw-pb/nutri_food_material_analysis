# 依赖
node_modules/

# 本地敏感配置（密钥、AppID、CloudBase 环境 ID 等）
.env
.env.local
miniprogram/services/config.ts

# 微信开发者工具本地/私有配置（含本地 AppID、编译设置）
project.private.config.json

# TypeScript 编译产物（DevTools 内置 TS 插件会就地生成 .js，不应提交）
miniprogram/**/*.js
miniprogram/**/*.js.map
!miniprogram/**/*.config.js

# 小程序 npm 构建产物
miniprogram_npm/

# 系统与编辑器
.DS_Store
.idea/
.vscode/
*.log
