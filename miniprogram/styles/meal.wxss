/* 结果、历史详情、饭后评估共用的食材与数据组件。 */
.meal-head { display: flex; align-items: center; gap: 24rpx; }
.meal-img { width: 144rpx; height: 144rpx; border-radius: 22rpx; flex-shrink: 0; }
.meal-meta { flex: 1; min-width: 0; }
.recognized-name { font-size: 38rpx; line-height: 1.4; font-weight: 600; margin-bottom: 10rpx; word-break: break-all; }
.meal-method { color: var(--sub); font-size: 25rpx; margin-top: 8rpx; }
.meal-overview .participant-identity { margin-top: 26rpx; margin-bottom: 16rpx; }
.estimate-banner { color: var(--sub); font-size: 24rpx; line-height: 1.6; }
.mealtype-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
button.mealtype-chip { box-sizing: border-box; flex: 0 0 31%; width: 31%; min-width: 0; margin: 0; padding: 18rpx 12rpx; min-height: 88rpx; border: 2rpx solid var(--border); border-radius: 18rpx; background: #f5f7f1; color: var(--sub); font-size: 28rpx; font-weight: 400; line-height: 1.6; }
button.mealtype-active { background: var(--primary-soft); border-color: var(--primary); color: var(--primary-dark); font-weight: 600; }
.summary-card { background: #edf3e7; border-color: #d9e4cf; box-shadow: none; }
.dish-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.dish-head .title-md { font-size: 32rpx; }
.match-tag { background: rgba(255,255,255,.8); }
.summary-line { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx 18rpx; margin-top: 18rpx; }
.summary-label { flex-shrink: 0; }
.summary-value { font-size: 38rpx; font-weight: 600; color: var(--primary-dark); }
.plate-note { font-size: 24rpx; }
.ingredient-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 12rpx; margin: 32rpx 4rpx 12rpx; }
.ingredient-heading .muted { font-size: 24rpx; }
.ingredient-help { margin: 0 4rpx 24rpx; }
.ing-card { padding-bottom: 20rpx; }
.row-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.ing-name { font-size: 36rpx; font-weight: 600; flex: 1; min-width: 0; word-break: break-all; }
button.delete-ingredient { flex-shrink: 0; width: auto; min-width: 88rpx; min-height: 80rpx; margin: 0; padding: 16rpx 18rpx; border-radius: 16rpx; line-height: 1.6; color: var(--danger); background: #faf0eb; font-size: 26rpx; font-weight: 400; }
.weight-line { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx; }
.weight-value { font-size: 40rpx; font-weight: 600; color: var(--primary-dark); }
.weight-range { font-size: 25rpx; }
.reading-block { margin-top: 22rpx; }
.reading-block + .reading-block { border-top: 1rpx solid var(--border); padding-top: 20rpx; }
.reading-head { font-size: 24rpx; margin-bottom: 12rpx; }
.metric-main { display: flex; align-items: center; gap: 18rpx; margin-top: 16rpx; }
.metric-label { font-size: 28rpx; color: var(--sub); flex-shrink: 0; }
.hardness-track { flex: 1; min-width: 0; height: 14rpx; border-radius: 20rpx; background: #e9eee2; overflow: hidden; }
.hardness-bar { height: 100%; border-radius: 20rpx; background: linear-gradient(90deg, #a7b887, #377a5b); transition: width 400ms ease; }
.metric-value { font-size: 32rpx; font-weight: 600; color: var(--primary-dark); min-width: 90rpx; text-align: right; }
.metric-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.metric-pill { padding: 8rpx 16rpx; border-radius: 12rpx; background: #f2f5ed; color: var(--sub); font-size: 26rpx; }
.metric-table { margin-top: 24rpx; background: #f6f8f2; border-radius: 18rpx; padding: 8rpx 20rpx; }
.metric-line { display: flex; justify-content: space-between; align-items: baseline; gap: 16rpx; padding: 14rpx 0; }
.metric-line + .metric-line { border-top: 1rpx solid var(--border); }
.metric-name, .metric-num { font-size: 26rpx; }
.metric-num { color: var(--text); text-align: right; }
.metric-unit { font-size: 23rpx; }
.ing-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0 20rpx; margin-top: 20rpx; padding-top: 4rpx; border-top: 1rpx solid var(--border); }
button.alt-toggle-sm, button.reset-link { width: auto; max-width: none; min-height: 88rpx; margin: 0; padding: 22rpx 0; line-height: 1.6; text-align: left; background: transparent; color: var(--primary-dark); font-size: 26rpx; font-weight: 500; }
button.reset-link { color: var(--sub); font-weight: 400; }
.unmatched, .match-review-note { margin-top: 18rpx; padding: 18rpx 20rpx; color: var(--warn-text); background: var(--warn-bg); border-radius: 18rpx; font-size: 26rpx; line-height: 1.65; }
.alt-panel { margin-top: 12rpx; background: #f3f6ed; border-radius: 20rpx; padding: 20rpx; }
.alt-search { width: 100%; height: 92rpx; background: #fff; border: 2rpx solid #cfdbc7; border-radius: 16rpx; padding: 0 20rpx; font-size: 26rpx; margin-bottom: 20rpx; }
.alt-empty { padding: 16rpx 0; }
button.alt-row { display: block; width: 100%; max-width: none; background: #fff; border: 2rpx solid var(--border); border-radius: 16rpx; padding: 20rpx; margin: 0 0 14rpx; text-align: left; line-height: 1.6; color: var(--text); font-weight: 400; }
button.alt-selected { border-color: var(--primary); background: var(--primary-soft); }
.alt-title { font-size: 28rpx; font-weight: 600; }
.alt-sub { margin-top: 6rpx; font-size: 24rpx; }
.retake-entry { margin: 28rpx 0; }
.retake-button { width: 100%; }
.evaluation-hint { text-align: center; margin-top: 14rpx; font-size: 25rpx; }
.dock-actions { display: flex; gap: 16rpx; }
.dock-actions .btn { flex: 1; width: 0; padding-left: 12rpx; padding-right: 12rpx; font-size: 30rpx; }
.home-link { width: 100%; margin-top: 16rpx; }
@media (prefers-reduced-motion: reduce) { .hardness-bar { transition: none; } }

button.retake-inline { display: flex; gap: 12rpx; width: 100%; max-width: none; justify-content: flex-end; margin-top: 12rpx; padding: 20rpx 0 0; border-top: 1rpx solid var(--border); font-size: 27rpx; }
.alt-main { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
