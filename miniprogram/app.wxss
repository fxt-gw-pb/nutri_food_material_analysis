/* 温润米白、深青绿；全页面共享的可访问界面。 */
page {
  --bg: #f6f7f2;
  --card: #ffffff;
  --primary: #246b56;
  --primary-dark: #194f40;
  --primary-soft: #eaf2e9;
  --text: #203c32;
  --sub: #5d7065;
  --muted: #69796f;
  --border: #e5ebe1;
  --warn-bg: #faf1df;
  --warn-text: #876229;
  --danger: #a74437;
  --shadow: 0 10rpx 36rpx rgba(34, 67, 48, 0.045);
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}
view, text, button, input { box-sizing: border-box; }
button::after { border: 0; }
.container { padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); min-height: 100vh; }
.with-dock { padding-bottom: calc(212rpx + env(safe-area-inset-bottom)); }
.card { padding: 30rpx; margin-bottom: 24rpx; background: var(--card); border: 1rpx solid var(--border); border-radius: 28rpx; box-shadow: var(--shadow); }
.title-lg { font-size: 46rpx; line-height: 1.35; font-weight: 700; letter-spacing: 1rpx; }
.title-md { font-size: 36rpx; line-height: 1.4; font-weight: 600; }
.title-sm { font-size: 32rpx; font-weight: 600; }
.sub { color: var(--sub); }
.muted { color: var(--muted); font-size: 26rpx; }
.eyebrow { display: flex; align-items: center; gap: 12rpx; color: var(--primary); font-size: 24rpx; font-weight: 600; letter-spacing: 3rpx; margin-bottom: 16rpx; }
.page-heading { margin: 12rpx 2rpx 32rpx; }
.page-description { margin-top: 12rpx; font-size: 28rpx; color: var(--sub); }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.section-number { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 44rpx; height: 44rpx; margin-right: 14rpx; border-radius: 14rpx; background: var(--primary-soft); color: var(--primary); font-size: 24rpx; font-weight: 700; }
.section-title { display: flex; align-items: center; font-size: 32rpx; font-weight: 600; }
.ui-icon { display: block; width: 44rpx; height: 44rpx; flex-shrink: 0; }
.icon-sm { width: 32rpx; height: 32rpx; }
.btn, button.btn { display: flex; align-items: center; justify-content: center; gap: 16rpx; width: 100%; max-width: none; min-height: 96rpx; height: auto; padding: 22rpx 28rpx; margin: 0; border: 0; border-radius: 24rpx; font-size: 32rpx; line-height: 1.5; font-weight: 600; transition: transform 160ms ease, background-color 160ms ease, opacity 160ms ease; }
.btn-primary { background: var(--primary); color: #fff; box-shadow: 0 8rpx 20rpx rgba(36, 107, 86, 0.13); }
.btn-secondary { background: var(--primary-soft); color: var(--primary-dark); }
.btn-ghost { background: transparent; color: var(--sub); border: 2rpx solid var(--border); }
.btn-primary.btn-disabled, button.btn[disabled] { background: #e1e7df; color: #6b796e; box-shadow: none; }
.btn-hover { transform: scale(0.98); opacity: 0.86; }
.surface-hover { background: #edf3e9; }
.text-button, button.text-button { display: inline-flex; align-items: center; justify-content: center; min-height: 88rpx; width: auto; margin: 0; padding: 16rpx 12rpx; background: transparent; color: var(--primary); font-size: 28rpx; font-weight: 500; line-height: 1.5; }
.tag { display: inline-flex; align-items: center; padding: 6rpx 16rpx; border-radius: 12rpx; font-size: 24rpx; background: var(--primary-soft); color: var(--primary-dark); flex-shrink: 0; }
.tag-neutral { background: #f1f3ee; color: var(--sub); }
.participant-identity { padding: 20rpx 24rpx; margin-bottom: 20rpx; border: 1rpx solid #dce8d8; border-radius: 20rpx; background: var(--primary-soft); color: var(--primary-dark); min-width: 0; }
.participant-label { font-size: 26rpx; }
.participant-code { display: block; font-size: 36rpx; line-height: 1.45; font-weight: 700; word-break: break-all; }
.profile-input { height: 96rpx; width: 100%; margin-top: 20rpx; padding: 0 24rpx; border: 2rpx solid #cbd8c8; border-radius: 20rpx; background: #f9fbf6; color: var(--text); font-size: 34rpx; }
.input-placeholder { color: #738175; font-size: 28rpx; }
/* AI 用途明示：放在各页第一屏，说明只做识别、不生成内容，以及数据来源。 */
.ai-notice { display: flex; align-items: flex-start; gap: 18rpx; margin: 0 0 24rpx; padding: 24rpx 26rpx; border: 2rpx solid #bcd7c8; border-radius: 22rpx; background: #eef6f1; color: var(--primary-dark); }
.ai-notice-badge { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; min-width: 56rpx; height: 44rpx; padding: 0 10rpx; margin-top: 2rpx; border-radius: 12rpx; background: var(--primary); color: #fff; font-size: 24rpx; font-weight: 700; letter-spacing: 1rpx; }
.ai-notice-body { flex: 1; min-width: 0; }
.ai-notice-title { font-size: 30rpx; line-height: 1.45; font-weight: 700; }
.ai-notice-text { margin-top: 6rpx; font-size: 26rpx; line-height: 1.65; color: #2f5a4a; }
.disclaimer { background: #f0f2e9; color: #63705c; border-radius: 20rpx; padding: 22rpx 24rpx; font-size: 24rpx; line-height: 1.75; }
.divider { height: 1rpx; background: var(--border); margin: 24rpx 0; }
.thumb-placeholder { display: flex; align-items: center; justify-content: center; background: var(--primary-soft); }
.thumb-placeholder .ui-icon { width: 60rpx; height: 60rpx; }
.action-dock { position: fixed; z-index: 10; bottom: 0; left: 0; right: 0; padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background: #fcfdf9; border-top: 1rpx solid var(--border); box-shadow: 0 -8rpx 32rpx rgba(34, 67, 48, 0.04); }
.dock-hint { margin-bottom: 14rpx; font-size: 24rpx; color: var(--sub); text-align: center; }
.state-card { padding: 64rpx 32rpx; text-align: center; }
.state-icon { display: flex; align-items: center; justify-content: center; width: 120rpx; height: 120rpx; margin: 0 auto 28rpx; background: var(--primary-soft); border-radius: 36rpx; }
.state-icon .ui-icon { width: 56rpx; height: 56rpx; }
.state-title { font-size: 34rpx; font-weight: 600; }
.state-copy { margin: 12rpx 0 28rpx; font-size: 28rpx; color: var(--sub); }
.state-card .btn { margin-top: 24rpx; }
.skeleton { background: #e8ede3; border-radius: 12rpx; animation: skeleton-breathe 1.4s ease-in-out 8; }
.skeleton-title { width: 54%; height: 38rpx; margin-bottom: 24rpx; }
.skeleton-line { width: 90%; height: 24rpx; margin-top: 16rpx; }
.skeleton-short { width: 62%; }
.loading-mark { width: 48rpx; height: 48rpx; margin: 0 auto 24rpx; border: 5rpx solid #e0eadd; border-top-color: var(--primary); border-radius: 50%; animation: spin 1s linear infinite; }
.reveal { animation: reveal 420ms ease-out backwards; }
.reveal-delay { animation-delay: 90ms; }
@keyframes reveal { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: none; } }
@keyframes skeleton-breathe { 50% { opacity: 0.45; } }
@keyframes spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .reveal, .skeleton, .loading-mark { animation: none; } .btn { transition: none; } }
