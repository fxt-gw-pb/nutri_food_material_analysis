@import "../result/result.wxss";

.source-line {
  margin-top: 12rpx;
  line-height: 1.5;
  word-break: break-all;
}

/* ---- 逐食材展示（与结果页同一套视觉） ---- */
.tag-none { background: var(--warn-bg); color: var(--warn-text); }
.matched-from {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.reading-block { margin-top: 20rpx; }
.reading-block + .reading-block {
  border-top: 1rpx solid var(--border);
  padding-top: 20rpx;
}
.reading-head {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

/* ---- 估重 ---- */
.weight-line {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}
.weight-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-dark);
}
.weight-range { font-size: 24rpx; margin-left: 6rpx; }
.weight-basis {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.plate-note { font-size: 24rpx; margin-left: 12rpx; }
