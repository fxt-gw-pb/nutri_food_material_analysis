.estimate-banner {
  background: var(--primary-soft);
  color: var(--primary-dark);
  text-align: center;
  font-size: 26rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.meal-head {
  display: flex;
  align-items: center;
}
.meal-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.meal-meta { flex: 1; }

.dish-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.conf-row {
  display: flex;
  gap: 32rpx;
  margin-top: 8rpx;
}
.total-line {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-top: 20rpx;
}
.total-g {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary-dark);
}
.record-pill {
  display: inline-block;
  margin-top: 20rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-size: 26rpx;
}

.ing-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 12rpx 0;
}
.ing-name { font-size: 30rpx; }
.ing-vals { display: flex; gap: 24rpx; }
.ing-est { color: var(--sub); }
.ing-consumed { color: var(--primary-dark); font-weight: 600; }

.limitations {
  margin-top: 24rpx;
  background: #fafcfb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.limit-item { line-height: 1.7; }

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.summary-g {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary-dark);
}
