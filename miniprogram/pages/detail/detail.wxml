<view class="container">
  <view class="estimate-banner">质构数据为同类菜肴实测参考值</view>

  <view class="card meal-head">
    <image wx:if="{{imageUrl}}" class="meal-img" src="{{imageUrl}}" mode="aspectFill" />
    <view wx:else class="meal-img thumb-placeholder">🍽️</view>
    <view class="meal-meta">
      <view class="muted">{{dateText}}</view>
      <view class="sub"><text class="tag">{{mealTypeText}}</text> · 识别为 {{recognizedName}}</view>
      <view class="sub" wx:if="{{cookingMethod}}">烹饪方式 {{cookingMethod}} · 可信度 {{confidenceText}}</view>
    </view>
  </view>

  <view class="card dish">
    <view class="dish-head">
      <view class="title-md">{{matched ? matchedDish : '未匹配到菜品'}}</view>
      <view class="tag match-tag">{{matchTypeText}}</view>
    </view>
    <view wx:if="{{edited}}" class="edited-row">
      <text class="tag tag-edited">已手动改选</text>
    </view>

    <block wx:if="{{matched}}">
      <view class="summary-line">
        <text class="summary-label muted">整体</text>
        <text class="summary-value">{{summary}}</text>
      </view>

      <view class="divider"></view>
      <view class="ing-title muted">这道菜的实测数据（{{rows.length}} 项取样）</view>

      <view wx:for="{{rows}}" wx:key="source" wx:for-item="row" class="row-block">
        <view class="row-head">
          <text class="ing-name">{{row.wholeDish ? '整菜取样' : row.ingredient}}</text>
          <text class="muted">{{row.cookingText}}</text>
        </view>

        <view class="metric-main">
          <text class="metric-label">软硬</text>
          <view class="hardness-track">
            <view class="hardness-bar" style="width: {{row.hardnessPercent}}%;"></view>
          </view>
          <text class="metric-value">{{row.hardnessText}}</text>
        </view>

        <view class="metric-row">
          <text class="metric-pill">嚼起来 {{row.chewinessText}}</text>
          <text class="metric-pill">{{row.adhesivenessText}}</text>
        </view>

        <view class="metric-table">
          <view wx:for="{{row.metrics}}" wx:key="label" wx:for-item="m" class="metric-line">
            <text class="metric-name muted">{{m.label}}</text>
            <text class="metric-num">{{m.value}}<text class="metric-unit muted"> {{m.unit}}</text></text>
          </view>
        </view>
        <view class="muted source-line">数据出处：{{row.source}}</view>
      </view>
    </block>
    <view wx:else class="unmatched">未匹配到质构数据</view>
  </view>

  <view class="disclaimer">
    质构数据来自实验室对同类菜肴样本的 TPA 全质构测试，仅供参考软硬与咀嚼难度，不等同于您这一份菜的实测值，也不构成医学建议。
  </view>
</view>
