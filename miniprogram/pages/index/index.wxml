<view class="container home-page">
  <view class="hero reveal">
    <view class="eyebrow"><image class="ui-icon icon-sm" src="/assets/icons/leaf.svg" />菜品质构识别</view>
    <view class="hero-main">
      <view class="hero-copy">
        <view class="hero-title">认真吃饭，<view>轻松记录。</view></view>
        <view class="hero-tagline">拍一拍，了解食材与软硬。</view>
      </view>
      <image class="hero-plate" src="/assets/illustrations/meal-plate.svg" mode="aspectFit" aria-hidden="true" />
    </view>
    <view class="hero-foot"><view class="status-dot"></view>同类菜肴实测数据 · 每种食材单独查看</view>
  </view>
  <view class="card profile-card reveal reveal-delay">
    <view class="section-head"><view class="section-title"><image class="ui-icon icon-sm" src="/assets/icons/person.svg" />这次为谁记录</view><text class="tag tag-neutral">参与者编号</text></view>
    <input class="profile-input" type="text" maxlength="32" value="{{participantCode}}" placeholder="请输入参与者编号（ID）" placeholder-class="input-placeholder" aria-label="参与者编号（ID）" bindinput="onParticipantCodeInput" />
    <view class="profile-hint">换人记录前，请更换编号。已保存的记录不受影响。</view>
    <button class="btn btn-primary start-button" hover-class="btn-hover" bindtap="goUpload"><image class="ui-icon" src="/assets/icons/camera-white.svg" />开始拍照识别<text class="button-arrow">↗</text></button>
  </view>
  <view class="home-shortcuts reveal reveal-delay">
    <button class="shortcut" hover-class="surface-hover" bindtap="goHistory">
      <view class="shortcut-top"><view class="shortcut-icon"><image class="ui-icon" src="/assets/icons/history.svg" /></view><text class="shortcut-arrow">↗</text></view>
      <view class="shortcut-title">饮食记录</view><view class="shortcut-desc">查看记录 · 饭后评估</view>
    </button>
    <button class="shortcut shortcut-warm" hover-class="surface-hover" bindtap="goQuestionnaire">
      <view class="shortcut-top"><view class="shortcut-icon"><image class="ui-icon" src="/assets/icons/questionnaire.svg" /></view><text class="shortcut-arrow">↗</text></view>
      <view class="shortcut-title">每周随访</view><view class="shortcut-desc">6 个问题，记录近况</view>
    </button>
  </view>
  <button class="shortcut shortcut-daily reveal reveal-delay" hover-class="surface-hover" bindtap="goDaily">
    <view class="shortcut-icon"><image class="ui-icon" src="/assets/icons/chart.svg" /></view>
    <view class="daily-entry-text"><view class="shortcut-title">每日汇总</view><view class="shortcut-desc">一餐、一天吃下的质构系数与营养</view></view>
    <text class="shortcut-arrow">↗</text>
  </button>
  <view class="home-secondary"><text class="muted">让每一餐，都有迹可循</text><button class="text-button" hover-class="btn-hover" bindtap="goQuestionnaireHistory">问卷记录 <text> ›</text></button></view>
  <view class="card guide-card">
    <button class="guide-toggle" hover-class="surface-hover" aria-expanded="{{guideOpen}}" bindtap="toggleGuide"><view class="section-title"><image class="ui-icon icon-sm" src="/assets/icons/spark.svg" />第一次使用？</view><text class="guide-toggle-label">{{guideOpen ? '收起 −' : '看看怎么用 ＋'}}</text></button>
    <view wx:if="{{guideOpen}}" class="guide-content reveal">
      <view class="step"><text class="step-no">1</text><view><view class="step-title">拍下一道菜</view><view class="muted">整只餐盘入镜，选好餐盘直径</view></view></view>
      <view class="step"><text class="step-no">2</text><view><view class="step-title">核对食材与份量</view><view class="muted">查看软硬，删掉照片里没有的食材</view></view></view>
      <view class="step"><text class="step-no">3</text><view><view class="step-title">吃完，再记一笔</view><view class="muted">全部拍完后保存，从饮食记录填写饭后评估</view></view></view>
    </view>
  </view>
  <view class="home-disclaimer">质构为同类食材的实测参考，估重为图像估算，<text>均不等同于这份菜的实测值，也不构成医学建议。</text></view>
</view>
