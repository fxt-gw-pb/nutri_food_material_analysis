.home-page { padding-top: 28rpx; }
.hero { padding: 12rpx 4rpx 32rpx; }
.hero-main { position: relative; display: flex; align-items: center; min-height: 222rpx; }
.hero-copy { position: relative; z-index: 1; flex: 1; }
.hero-title { font-size: 52rpx; font-weight: 700; line-height: 1.4; letter-spacing: 2rpx; }
.hero-title > view { color: var(--primary); }
.hero-tagline { margin-top: 18rpx; font-size: 27rpx; color: var(--sub); }
.hero-plate { width: 246rpx; height: 246rpx; margin: -10rpx -12rpx 0 -10rpx; flex-shrink: 0; animation: float-plate 4s ease-in-out 2; }
.hero-foot { display: flex; align-items: center; gap: 10rpx; margin-top: 16rpx; font-size: 24rpx; color: var(--sub); }
.status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #9bad70; flex-shrink: 0; }
.profile-card { border-color: #dce6d7; }
.profile-card .section-title, .guide-toggle .section-title { gap: 12rpx; }
.profile-card .section-head { margin-bottom: 0; }
.profile-hint { margin: 14rpx 0 24rpx; font-size: 24rpx; color: var(--sub); }
.start-button { min-height: 104rpx; }
.button-arrow { margin-left: auto; font-size: 36rpx; font-weight: 400; }
.home-shortcuts { display: flex; gap: 20rpx; }
button.shortcut { flex: 1; width: 0; max-width: none; margin: 0; padding: 26rpx; border: 1rpx solid #dce6d7; border-radius: 26rpx; background: #edf3e9; color: var(--text); text-align: left; line-height: 1.5; }
button.shortcut-warm { background: #f3efdf; border-color: #e9e3ce; }
.shortcut-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.shortcut-icon { padding: 14rpx; border-radius: 20rpx; background: rgba(255,255,255,0.75); }
.shortcut-arrow { color: var(--sub); font-size: 32rpx; font-weight: 400; }
.shortcut-title { font-size: 32rpx; font-weight: 600; }
.shortcut-desc { font-size: 24rpx; color: var(--sub); margin-top: 8rpx; font-weight: 400; }
.home-secondary { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 4rpx 12rpx; gap: 12rpx; }
.home-secondary .muted { font-size: 24rpx; }
.guide-card { padding: 0; overflow: hidden; }
button.guide-toggle { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100%; max-width: none; margin: 0; padding: 26rpx; background: #fff; color: var(--text); line-height: 1.5; text-align: left; }
.guide-toggle .section-title { font-size: 28rpx; }
.guide-toggle-label { font-size: 24rpx; color: var(--primary); font-weight: 400; }
.guide-content { padding: 0 28rpx 28rpx; }
.step { display: flex; align-items: flex-start; gap: 20rpx; padding-top: 24rpx; }
.step-no { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; flex-shrink: 0; border-radius: 50%; background: var(--primary-soft); color: var(--primary); font-size: 24rpx; }
.step-title { font-size: 28rpx; font-weight: 600; }
.home-disclaimer { padding: 0 8rpx; font-size: 23rpx; line-height: 1.8; color: var(--sub); }
.home-disclaimer text { display: block; }
@keyframes float-plate { 50% { transform: translateY(-8rpx) rotate(3deg); } }
@media (prefers-reduced-motion: reduce) { .hero-plate { animation: none; } }
button.shortcut-daily { display: flex; align-items: center; gap: 22rpx; width: 100%; flex: none; margin-top: 20rpx; background: #eef3f1; border-color: #d9e6e0; }
.daily-entry-text { flex: 1; min-width: 0; }
