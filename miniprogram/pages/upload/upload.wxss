.picker {
  margin-top: 24rpx;
  height: 320rpx;
  border: 2rpx dashed #cdd8d1;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafcfb;
}
.picker-icon { font-size: 64rpx; }
.picker-text { margin-top: 12rpx; color: var(--sub); }

.preview { margin-top: 24rpx; }
.preview-img {
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  background: #f0f2f1;
}
.preview-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.btn-sm {
  height: 72rpx;
  font-size: 28rpx;
  flex: 1;
}

.diameter-hint { margin: 8rpx 0 20rpx; }
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.chip {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: #f0f2f1;
  color: var(--sub);
  font-size: 28rpx;
}
.chip-active {
  background: var(--primary);
  color: #ffffff;
}
.custom-input {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
}
.custom-field { flex: 1; }
.custom-unit { color: var(--sub); margin-left: 12rpx; }

.tips { margin-top: 12rpx; }
.tip {
  display: flex;
  color: var(--sub);
  padding: 8rpx 0;
}
.tip-dot {
  color: var(--primary);
  margin-right: 16rpx;
  font-weight: 700;
}

.submit {
  margin-top: 8rpx;
}
