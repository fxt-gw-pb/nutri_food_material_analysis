@import "../../styles/meal.wxss";
@import "../../styles/intake.wxss";
.identity-hint { color: var(--sub); font-size: 26rpx; margin-bottom: 22rpx; }
.evaluation-photo { display: block; width: 100%; height: 300rpx; border-radius: 20rpx; background: #f1f4ea; margin-bottom: 24rpx; }
.meal-date { margin-top: 8rpx; }
.portion-guide { display: flex; padding: 20rpx 0; margin-top: 24rpx; border-radius: 20rpx; background: #f1f5ea; }
.portion-guide > view { display: flex; flex: 1; flex-direction: column; text-align: center; color: var(--sub); font-size: 25rpx; }
.portion-guide > view + view { border-left: 1rpx solid #dce5d2; }
.portion-number { color: var(--primary-dark); font-size: 32rpx; font-weight: 600; }
.portion-help { color: var(--sub); font-size: 25rpx; margin-top: 18rpx; }
.evaluation-progress { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 32rpx 4rpx 20rpx; font-weight: 600; }
.evaluation-progress .muted { font-weight: 400; }
.portion-card { border: 2rpx solid var(--border); transition: border-color 180ms ease; }
.portion-confirmed { border-color: #9dbb91; }
.percent-line { display: flex; align-items: center; flex-wrap: wrap; gap: 20rpx; margin: 24rpx 0; }
.percent-value { font-size: 48rpx; font-weight: 600; color: var(--primary-dark); line-height: 1.2; }
.confirm-status { font-size: 24rpx; color: var(--sub); }
.is-confirmed { padding: 6rpx 16rpx; background: var(--primary-soft); border-radius: 12rpx; color: var(--primary-dark); }
.presets { display: flex; flex-wrap: wrap; gap: 12rpx; }
.presets button.preset { display: flex; align-items: center; justify-content: center; flex-direction: column; box-sizing: border-box; flex: 0 0 23%; width: 23%; max-width: none; min-width: 0; min-height: 92rpx; margin: 0; padding: 14rpx 4rpx; line-height: 1.4; border: 2rpx solid var(--border); border-radius: 16rpx; font-size: 29rpx; font-weight: 500; background: #f5f7f0; color: var(--text); transition: background 160ms ease; }
.presets button.selected { background: var(--primary); border-color: var(--primary); color: white; }
.preset-label { font-size: 22rpx; margin-top: 4rpx; font-weight: 400; }
.slider-caption { font-size: 25rpx; color: var(--sub); margin-top: 24rpx; }
.scale { display: flex; justify-content: space-between; margin: -8rpx 20rpx 0; color: var(--sub); font-size: 24rpx; }
.intake { margin-top: 22rpx; color: var(--primary-dark); font-size: 28rpx; line-height: 1.6; }
.intake text { font-size: 34rpx; font-weight: 600; margin-left: 12rpx; }
.save-status { margin-top: 16rpx; color: var(--sub); font-size: 26rpx; }
.submit-identity { font-size: 28rpx; word-break: break-all; }
.submit-code { font-weight: 600; }
@media (prefers-reduced-motion: reduce) { .portion-card, .presets button.preset { transition: none; } }

.evaluation-intake .dish-head { margin-bottom: 16rpx; }
