<view class="container">
  <view class="estimate-banner">质构数据为同类菜肴实测参考值</view>

  <!-- 照片与时间 -->
  <view class="card meal-head">
    <image wx:if="{{imageUrl}}" class="meal-img" src="{{imageUrl}}" mode="aspectFill" />
    <view wx:else class="meal-img thumb-placeholder">🍽️</view>
    <view class="meal-meta">
      <view class="muted">{{dateText}}</view>
      <view class="sub">共识别出 {{dishViews.length}} 道菜</view>
    </view>
  </view>

  <!-- 餐次选择 -->
  <view class="card">
    <view class="ing-title muted">这一餐是</view>
    <view class="mealtype-row">
      <view
        wx:for="{{mealTypeOptions}}"
        wx:key="type"
        wx:for-item="opt"
        class="mealtype-chip {{mealType === opt.type ? 'mealtype-active' : ''}}"
        data-type="{{opt.type}}"
        bindtap="selectMealType"
      >{{opt.label}}</view>
    </view>
  </view>

  <!-- 菜品卡片 -->
  <view wx:for="{{dishViews}}" wx:key="dishId" wx:for-item="dish" wx:for-index="dishIndex" class="card dish">
    <view class="dish-head">
      <view class="title-md">{{dish.dishName}}</view>
      <view class="tag tag-neutral" wx:if="{{dish.cookingMethod}}">{{dish.cookingMethod}}</view>
    </view>
    <view class="conf-row">
      <text class="tag match-tag">{{dish.matchTypeText}}</text>
      <text class="muted">识别可信度 {{dish.confidenceText}}</text>
    </view>
    <view class="muted match-note">{{dish.matchNote}}</view>

    <!-- 每种原食材一块 -->
    <view wx:for="{{dish.items}}" wx:key="queryName" wx:for-item="item" wx:for-index="itemIndex" class="ing-block">
      <view class="divider"></view>

      <view class="ing-head">
        <text class="ing-name">{{item.queryName}}</text>
        <text wx:if="{{item.edited}}" class="tag tag-edited">已手动改选</text>
      </view>

      <block wx:if="{{item.matched}}">
        <view class="matched-line">
          <text class="matched-title">{{item.title}}</text>
          <text class="muted matched-cooking">{{item.cookingText}}</text>
        </view>

        <!-- 软硬刻度 -->
        <view class="metric-main">
          <text class="metric-label">软硬</text>
          <view class="hardness-track">
            <view class="hardness-bar" style="width: {{item.hardnessPercent}}%;"></view>
          </view>
          <text class="metric-value">{{item.hardnessText}}</text>
        </view>

        <view class="metric-row">
          <text class="metric-pill">嚼起来 {{item.chewinessText}}</text>
          <text class="metric-pill">{{item.adhesivenessText}}</text>
        </view>
      </block>
      <view wx:else class="unmatched">库里没有足够接近的数据，请在下方自己选一个</view>

      <!-- 相似备选 -->
      <view
        class="alt-toggle"
        data-dish="{{dishIndex}}"
        data-item="{{itemIndex}}"
        bindtap="toggleCandidates"
      >{{item.expanded ? '收起备选 ▲' : '不像？换一个 ▼'}}</view>

      <view wx:if="{{item.expanded}}" class="alt-panel">
        <input
          class="alt-search"
          type="text"
          placeholder="也可以直接搜菜名或食材，如「豆腐」"
          value="{{item.keyword}}"
          data-dish="{{dishIndex}}"
          data-item="{{itemIndex}}"
          bindinput="onSearchInput"
        />
        <view wx:if="{{item.candidates.length === 0}}" class="muted alt-empty">没有找到相关数据</view>
        <view
          wx:for="{{item.candidates}}"
          wx:key="recordId"
          wx:for-item="cand"
          class="alt-row {{cand.selected ? 'alt-selected' : ''}}"
          data-dish="{{dishIndex}}"
          data-item="{{itemIndex}}"
          data-id="{{cand.recordId}}"
          bindtap="selectCandidate"
        >
          <view class="alt-main">
            <text class="alt-title">{{cand.title}}</text>
            <text class="alt-score">{{cand.scorePercent}}%</text>
          </view>
          <view class="alt-sub muted">{{cand.cookingText}} · {{cand.categoryText}}</view>
          <view class="alt-reason muted">{{cand.reason}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="disclaimer">
    质构数据来自实验室对同类菜肴样本的 TPA 全质构测试，仅供参考软硬与咀嚼难度，不等同于您这一份菜的实测值，也不构成医学建议。
  </view>

  <view class="bottom-actions">
    <view class="btn btn-secondary" hover-class="btn-hover" bindtap="goHistory">查看历史</view>
    <view class="btn btn-primary" hover-class="btn-hover" bindtap="goHome">完成</view>
  </view>
</view>
