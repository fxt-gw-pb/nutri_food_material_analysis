<view class="container">
  <view class="estimate-banner">质构数据为同类食材实测参考值</view>

  <!-- 照片与识别出的菜 -->
  <view class="card meal-head">
    <image wx:if="{{imageUrl}}" class="meal-img" src="{{imageUrl}}" mode="aspectFill" />
    <view wx:else class="meal-img thumb-placeholder">🍽️</view>
    <view class="meal-meta">
      <view class="muted">{{dateText}}</view>
      <view class="sub">识别为 {{recognizedName}}</view>
      <view class="sub" wx:if="{{cookingMethod}}">烹饪方式 {{cookingMethod}} · 可信度 {{confidenceText}}</view>
    </view>
  </view>

  <!-- 餐次选择 -->
  <view class="card">
    <view class="ing-title muted">这一餐是</view>
    <view class="mealtype-row">
      <view
        wx:for="{{mealTypeOptions}}"
        wx:key="type"
        wx:for-item="opt"
        class="mealtype-chip {{mealType === opt.type ? 'mealtype-active' : ''}}"
        data-type="{{opt.type}}"
        bindtap="selectMealType"
      >{{opt.label}}</view>
    </view>
  </view>

  <!-- 整体摘要 -->
  <view class="card">
    <view class="dish-head">
      <view class="title-md">这道菜的食材</view>
      <view class="tag match-tag">{{matchedCount}}/{{totalCount}} 已匹配</view>
    </view>
    <view class="muted match-note">{{matchNote}}</view>
    <view wx:if="{{matchedCount > 0}}" class="summary-line">
      <text class="summary-label muted">整体</text>
      <text class="summary-value">{{summary}}</text>
    </view>
    <view wx:if="{{totalWeightText}}" class="summary-line">
      <text class="summary-label muted">总重</text>
      <text class="summary-value">{{totalWeightText}}</text>
      <text class="muted plate-note">按 {{plateDiameterCm}}cm 餐盘估算</text>
    </view>
  </view>

  <!-- 逐食材数据：一种食材一张卡 -->
  <view wx:for="{{ingredients}}" wx:key="name" wx:for-item="ing" wx:for-index="i" class="card ing-card">
    <view class="row-head">
      <text class="ing-name">{{ing.name}}</text>
      <text class="tag {{ing.matched ? (ing.edited ? 'tag-edited' : 'match-tag') : 'tag-none'}}">{{ing.matchTypeText}}</text>
    </view>

    <!-- 估重：与质构匹配相互独立，没匹配上质构也照样有重量 -->
    <view wx:if="{{ing.grams}}" class="weight-line">
      <text class="weight-value">{{ing.weightText}}</text>
      <text class="muted weight-range">（{{ing.weightRangeText}}）</text>
    </view>

    <view class="muted match-note">{{ing.reason}}</view>

    <block wx:if="{{ing.matched}}">
      <view class="matched-from muted">
        数据出自「{{ing.matchedDish}}」的{{ing.matchedIngredient}} · {{ing.matchedCookingText}} · {{ing.category}}
      </view>

      <!-- 切割 / 下压两种测试模式并列 -->
      <view wx:for="{{ing.readings}}" wx:key="testMode" wx:for-item="rd" class="reading-block">
        <view class="reading-head muted" wx:if="{{ing.readings.length > 1}}">{{rd.testMode}}</view>

        <view class="metric-main">
          <text class="metric-label">软硬</text>
          <view class="hardness-track">
            <view class="hardness-bar" style="width: {{rd.hardnessPercent}}%;"></view>
          </view>
          <text class="metric-value">{{rd.hardnessText}}</text>
        </view>

        <view class="metric-row">
          <text class="metric-pill">嚼起来 {{rd.chewinessText}}</text>
          <text class="metric-pill">{{rd.adhesivenessText}}</text>
        </view>

        <view wx:if="{{ing.detailOpen}}" class="metric-table">
          <view wx:for="{{rd.metrics}}" wx:key="label" wx:for-item="m" class="metric-line">
            <text class="metric-name muted">{{m.label}}</text>
            <text class="metric-num">{{m.value}}<text class="metric-unit muted"> {{m.unit}}</text></text>
          </view>
        </view>
      </view>

      <view wx:if="{{ing.detailOpen && ing.grams}}" class="muted weight-basis">估重依据：{{ing.weightBasis}}</view>

      <view class="ing-actions">
        <text class="alt-toggle-sm" data-index="{{i}}" bindtap="toggleDetail">
          {{ing.detailOpen ? '收起九项指标 ▲' : '看九项完整指标 ▼'}}
        </text>
        <text class="alt-toggle-sm" data-index="{{i}}" bindtap="togglePicker">
          {{ing.pickerOpen ? '收起备选 ▲' : '换一条数据 ▼'}}
        </text>
        <text wx:if="{{ing.edited}}" class="reset-link" data-index="{{i}}" bindtap="resetOne">恢复自动匹配</text>
      </view>
    </block>

    <block wx:else>
      <view class="unmatched">库里没有足够接近的食材，可以自己挑一条</view>
      <view class="ing-actions">
        <text class="alt-toggle-sm" data-index="{{i}}" bindtap="togglePicker">
          {{ing.pickerOpen ? '收起备选 ▲' : '自己挑一条 ▼'}}
        </text>
      </view>
    </block>

    <!-- 备选记录面板 -->
    <view wx:if="{{ing.pickerOpen}}" class="alt-panel">
      <input
        class="alt-search"
        type="text"
        placeholder="也可以直接搜食材或菜名，如「土豆」"
        value="{{keyword}}"
        bindinput="onSearchInput"
      />
      <view wx:if="{{ing.candidateViews.length === 0}}" class="muted alt-empty">没有找到相关数据</view>
      <view
        wx:for="{{ing.candidateViews}}"
        wx:key="id"
        wx:for-item="cand"
        class="alt-row {{cand.selected ? 'alt-selected' : ''}}"
        data-index="{{i}}"
        data-id="{{cand.id}}"
        bindtap="selectRecord"
      >
        <view class="alt-main">
          <text class="alt-title">{{cand.ingredient}}</text>
          <text class="alt-score">{{cand.scorePercent}}%</text>
        </view>
        <view class="alt-sub muted">出自「{{cand.dish}}」 · {{cand.cookingText}} · {{cand.testMode}}</view>
        <view class="alt-reason muted">{{cand.reason}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{totalCount === 0}}" class="card unmatched">没有识别出食材，换一张更清楚的照片试试</view>

  <view class="disclaimer">
    重量为按餐盘直径换算的图像估算，误差通常在三成上下，不等同于真实称重；质构数据来自实验室对同类食材样本的 TPA 全质构测试（切割 / 下压两种模式），仅供参考软硬与咀嚼难度，不等同于您这一份菜的实测值，也不构成医学建议。
  </view>

  <view class="bottom-actions">
    <view class="btn btn-secondary" hover-class="btn-hover" bindtap="goHistory">查看历史</view>
    <view class="btn btn-primary" hover-class="btn-hover" bindtap="goHome">完成</view>
  </view>
</view>
