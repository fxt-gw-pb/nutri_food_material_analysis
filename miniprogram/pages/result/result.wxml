<view class="container">
  <view class="estimate-banner">质构数据为同类菜肴实测参考值</view>

  <!-- 照片与时间 -->
  <view class="card meal-head">
    <image wx:if="{{imageUrl}}" class="meal-img" src="{{imageUrl}}" mode="aspectFill" />
    <view wx:else class="meal-img thumb-placeholder">🍽️</view>
    <view class="meal-meta">
      <view class="muted">{{dateText}}</view>
      <view class="sub">识别为 {{recognizedName}}</view>
      <view class="sub" wx:if="{{cookingMethod}}">烹饪方式 {{cookingMethod}} · 可信度 {{confidenceText}}</view>
    </view>
  </view>

  <!-- 餐次选择 -->
  <view class="card">
    <view class="ing-title muted">这一餐是</view>
    <view class="mealtype-row">
      <view
        wx:for="{{mealTypeOptions}}"
        wx:key="type"
        wx:for-item="opt"
        class="mealtype-chip {{mealType === opt.type ? 'mealtype-active' : ''}}"
        data-type="{{opt.type}}"
        bindtap="selectMealType"
      >{{opt.label}}</view>
    </view>
  </view>

  <!-- 匹配到的菜 + 它的源数据 -->
  <view class="card dish">
    <view class="dish-head">
      <view class="title-md">{{matched ? matchedDish : '未匹配到菜品'}}</view>
      <view class="tag match-tag">{{matchTypeText}}</view>
    </view>
    <view class="muted match-note">{{matchNote}}</view>
    <view wx:if="{{edited}}" class="edited-row">
      <text class="tag tag-edited">已手动改选</text>
      <text class="reset-link" bindtap="resetSelection">恢复自动匹配</text>
    </view>

    <block wx:if="{{matched}}">
      <view class="summary-line">
        <text class="summary-label muted">整体</text>
        <text class="summary-value">{{summary}}</text>
      </view>

      <view class="divider"></view>
      <view class="ing-title muted">这道菜的实测数据（{{rows.length}} 项取样）</view>

      <!-- 一种原食材一行；整菜取样时只有一行 -->
      <view wx:for="{{rows}}" wx:key="source" wx:for-item="row" class="row-block">
        <view class="row-head">
          <text class="ing-name">{{row.wholeDish ? '整菜取样' : row.ingredient}}</text>
          <text class="muted">{{row.cookingText}}</text>
        </view>

        <view class="metric-main">
          <text class="metric-label">软硬</text>
          <view class="hardness-track">
            <view class="hardness-bar" style="width: {{row.hardnessPercent}}%;"></view>
          </view>
          <text class="metric-value">{{row.hardnessText}}</text>
        </view>

        <view class="metric-row">
          <text class="metric-pill">嚼起来 {{row.chewinessText}}</text>
          <text class="metric-pill">{{row.adhesivenessText}}</text>
        </view>

        <view class="metric-table">
          <view wx:for="{{row.metrics}}" wx:key="label" wx:for-item="m" class="metric-line">
            <text class="metric-name muted">{{m.label}}</text>
            <text class="metric-num">{{m.value}}<text class="metric-unit muted"> {{m.unit}}</text></text>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="unmatched">库里没有足够接近的菜，请在下方自己选一道</view>
  </view>

  <!-- 换一道菜 -->
  <view class="card">
    <view class="alt-toggle" bindtap="togglePicker">
      {{pickerOpen ? '收起备选 ▲' : '不是这道菜？换一个 ▼'}}
    </view>

    <view wx:if="{{pickerOpen}}" class="alt-panel">
      <input
        class="alt-search"
        type="text"
        placeholder="也可以直接搜菜名或食材，如「豆腐」"
        value="{{keyword}}"
        bindinput="onSearchInput"
      />
      <view wx:if="{{candidates.length === 0}}" class="muted alt-empty">没有找到相关菜品</view>
      <view
        wx:for="{{candidates}}"
        wx:key="dish"
        wx:for-item="cand"
        class="alt-row {{cand.selected ? 'alt-selected' : ''}}"
        data-dish="{{cand.dish}}"
        bindtap="selectDish"
      >
        <view class="alt-main">
          <text class="alt-title">{{cand.dish}}</text>
          <text class="alt-score">{{cand.scorePercent}}%</text>
        </view>
        <view class="alt-sub muted">{{cand.ingredientText}} · {{cand.cookingText}} · {{cand.category}}</view>
        <view class="alt-reason muted">{{cand.reason}}</view>
      </view>
    </view>
  </view>

  <view class="disclaimer">
    质构数据来自实验室对同类菜肴样本的 TPA 全质构测试，仅供参考软硬与咀嚼难度，不等同于您这一份菜的实测值，也不构成医学建议。
  </view>

  <view class="bottom-actions">
    <view class="btn btn-secondary" hover-class="btn-hover" bindtap="goHistory">查看历史</view>
    <view class="btn btn-primary" hover-class="btn-hover" bindtap="goHome">完成</view>
  </view>
</view>
