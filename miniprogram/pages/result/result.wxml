<view class="container with-dock meal-page">
  <view wx:if="{{!loaded}}" class="card state-card">
    <block wx:if="{{loadError}}"><view class="state-title">暂时无法读取记录</view><view class="state-copy">{{loadError}}</view><button class="btn btn-secondary" bindtap="loadMeal">重新加载</button></block>
    <block wx:else><view class="loading-mark"></view><view class="state-title">正在读取菜品记录</view><view class="state-copy">照片与食材信息马上就好</view></block>
  </view>
  <block wx:else>
  <view class="page-heading reveal"><view class="eyebrow">识别结果</view><view class="title-lg">看看这一道菜</view></view>
  <view class="ai-notice" aria-label="以下菜名和食材由 AI 识别，请核对"><text class="ai-notice-badge">AI</text><view class="ai-notice-body"><view class="ai-notice-title">以下菜名和食材由 AI 识别，请核对</view><view class="ai-notice-text">AI 只做识别、不生成内容；认错的食材可以删除或更换。重量、软硬（质构）和营养由算法、实验室实测数据和《中国食物成分表》计算，仅供参考。</view></view></view>
  <view class="card meal-overview">
    <view class="meal-head">
      <image wx:if="{{imageUrl}}" class="meal-img" src="{{imageUrl}}" mode="aspectFill" bindtap="previewImage" aria-label="查看菜品原图" />
      <view wx:else class="meal-img thumb-placeholder"><image class="ui-icon" src="/assets/icons/plate.svg" /></view>
      <view class="meal-meta"><view class="recognized-name">{{recognizedName}}</view><view class="muted">{{dateText}}</view><view class="meal-method" wx:if="{{cookingMethod}}">{{cookingMethod}} · AI 识别可信度 {{confidenceText}}</view></view>
    </view>
    <view class="participant-identity"><view class="participant-label">参与者编号（ID）</view><text class="participant-code" user-select="true">{{participantCode || '未记录编号'}}</text></view>
    <view class="estimate-banner">质构为同类食材实测参考 · 重量为图像估算</view>
    <button wx:if="{{!evaluationCompleted || totalCount === 0}}" class="text-button retake-inline" bindtap="retake" loading="{{busy}}" disabled="{{busy || !loaded}}"><image class="ui-icon icon-sm" src="/assets/icons/refresh.svg" />我要重新拍照</button>
  </view>
  <!-- 整体摘要 -->
  <view class="card summary-card">
    <view class="dish-head">
      <view class="title-md">这道菜，一眼了解</view>
      <view class="tag match-tag">{{totalCount}} 种食材</view>
    </view>
    <view wx:if="{{matchedCount > 0}}" class="summary-line">
      <text class="summary-label muted">整体</text>
      <text class="summary-value">{{summary}}</text>
    </view>
    <view wx:if="{{totalWeightText}}" class="summary-line">
      <text class="summary-label muted">总重</text>
      <text class="summary-value">{{totalWeightText}}</text>
      <text class="muted plate-note">按 {{plateDiameterCm}}cm 餐盘估算</text>
    </view>
  </view>

  <!-- 餐次选择 -->
  <view class="card">
    <view class="ing-title muted">这是哪一餐</view>
    <view class="mealtype-row">
      <button
        wx:for="{{mealTypeOptions}}"
        wx:key="type"
        wx:for-item="opt"
        class="mealtype-chip {{mealType === opt.type ? 'mealtype-active' : ''}}"
        data-type="{{opt.type}}"
        bindtap="selectMealType"
       aria-label="{{opt.label + (mealType === opt.type ? '，已选择' : '')}}">{{opt.label}}</button>
    </view>
  </view>

  <view class="ingredient-heading"><view class="title-sm">逐一看看食材</view><text class="muted">{{matchedCount}} / {{totalCount}} 种已匹配质构</text></view>
  <view class="muted ingredient-help">核对食材；照片里没有的可以删除。</view>
  <!-- 逐食材数据：一种食材一张卡 -->
  <view wx:for="{{ingredients}}" wx:key="name" wx:for-item="ing" wx:for-index="i" class="card ing-card">
    <view class="row-head">
      <text class="ing-name">{{ing.name}}</text>
      <button class="delete-ingredient" size="mini" data-name="{{ing.name}}" bindtap="removeIngredient" disabled="{{busy || !loaded}}" aria-label="删除{{ing.name}}">删除</button>
    </view>

    <!-- 估重：与质构匹配相互独立，没匹配上质构也照样有重量 -->
    <view wx:if="{{ing.grams}}" class="weight-line">
      <text class="weight-value">{{ing.weightText}}</text>
      <text class="muted weight-range">（{{ing.weightRangeText}}）</text>
    </view>
    <view wx:if="{{ing.reviewNote}}" class="match-review-note">{{ing.reviewNote}}</view>

    <block wx:if="{{ing.matched}}">

      <!-- 切割 / 下压两种测试模式并列 -->
      <view wx:for="{{ing.readings}}" wx:key="testMode" wx:for-item="rd" class="reading-block">
        <view class="reading-head muted" wx:if="{{ing.readings.length > 1}}">{{rd.testMode}}</view>

        <view class="metric-main">
          <text class="metric-label">软硬</text>
          <view class="hardness-track">
            <view class="hardness-bar" style="width: {{rd.hardnessPercent}}%;"></view>
          </view>
          <text class="metric-value">{{rd.hardnessText}}</text>
        </view>

        <view class="metric-row">
          <text class="metric-pill">嚼起来 {{rd.chewinessText}}</text>
          <text class="metric-pill">{{rd.adhesivenessText}}</text>
        </view>

        <view wx:if="{{ing.detailOpen}}" class="metric-table reveal">
          <view wx:for="{{rd.metrics}}" wx:key="label" wx:for-item="m" class="metric-line">
            <text class="metric-name muted">{{m.label}}</text>
            <text class="metric-num">{{m.value}}<text class="metric-unit muted"> {{m.unit}}</text></text>
          </view>
        </view>
      </view>

      <view class="ing-actions">
        <button class="alt-toggle-sm" data-index="{{i}}" bindtap="toggleDetail" aria-expanded="{{ing.detailOpen}}">
          {{ing.detailOpen ? '收起详细指标 −' : '查看详细指标 ＋'}}
        </button>
        <button class="alt-toggle-sm" data-index="{{i}}" bindtap="togglePicker" aria-expanded="{{ing.pickerOpen}}">
          {{ing.pickerOpen ? '收起备选 −' : '更换匹配数据 ＋'}}
        </button>
        <button wx:if="{{ing.edited}}" class="reset-link" data-index="{{i}}" bindtap="resetOne">恢复自动匹配</button>
      </view>
    </block>

    <block wx:else>
      <view class="unmatched">库里没有足够接近的食材，可以自己挑一条</view>
      <view class="ing-actions">
        <button class="alt-toggle-sm" data-index="{{i}}" bindtap="togglePicker" aria-expanded="{{ing.pickerOpen}}">
          {{ing.pickerOpen ? '收起备选 −' : '选择参考数据 ＋'}}
        </button>
      </view>
    </block>

    <!-- 备选记录面板 -->
    <view wx:if="{{ing.pickerOpen}}" class="alt-panel reveal">
      <input
        aria-label="搜索质构库中的食材或菜名"
        class="alt-search"
        type="text"
        placeholder="也可以直接搜食材或菜名，如「土豆」"
        value="{{keyword}}"
        bindinput="onSearchInput"
      />
      <view wx:if="{{ing.candidateViews.length === 0}}" class="muted alt-empty">没有找到相关数据</view>
      <button
        wx:for="{{ing.candidateViews}}"
        wx:key="id"
        wx:for-item="cand"
        class="alt-row {{cand.selected ? 'alt-selected' : ''}}"
        data-index="{{i}}"
        data-id="{{cand.id}}"
        bindtap="selectRecord"
      >
        <view class="alt-main">
          <text class="alt-title">{{cand.ingredient}}</text><text wx:if="{{cand.selected}}" class="tag">✓ 已选</text>
        </view>
        <view class="alt-sub muted">{{cand.cookingText}} · {{cand.testMode}}</view>
      </button>
    </view>
  </view>

  <view wx:if="{{totalCount === 0}}" class="card unmatched">没有识别出食材，换一张更清楚的照片试试</view>

  <view class="disclaimer">菜名和食材由 AI 图像识别得出，可能有误，可删除或更换；本程序不生成图片、文字或音视频内容。重量按餐盘尺寸用几何算法估算，不等同于真实称重；质构数据来自实验室对同类食材的 TPA 测试，仅供参考软硬与咀嚼难度，不等同于这份菜的实测值；营养素按《中国食物成分表标准版（第 6 版）》换算。以上均不构成医学建议。</view>
  <button class="text-button home-link" bindtap="goHome">返回首页</button>
  <view class="action-dock">
    <block wx:if="{{mealSessionId && !sessionFinished}}">
      <view class="dock-hint">这顿饭还有菜没拍？可以继续添加。</view>
      <view class="dock-actions"><button class="btn btn-secondary" bindtap="continueMeal" disabled="{{busy || !loaded}}">继续拍下一道</button><button class="btn btn-primary" bindtap="finishMeal" loading="{{busy}}" disabled="{{busy || !loaded}}">拍完了</button></view>
    </block>
    <block wx:else>
      <view class="dock-hint">{{evaluationCompleted ? '评估已完成，可查看或修改食用比例' : '吃完饭后，记录每种食材吃了多少'}}</view>
      <view class="dock-actions"><button class="btn btn-secondary" bindtap="goHistory">饮食记录</button><button wx:if="{{totalCount > 0}}" class="btn btn-primary" bindtap="goEvaluation" disabled="{{busy || !loaded}}">饭后评估</button><button wx:else class="btn btn-primary" bindtap="goHome">完成</button></view>
    </block>
  </view>
  </block>
</view>
