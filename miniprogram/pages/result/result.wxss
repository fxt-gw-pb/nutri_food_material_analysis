.estimate-banner {
  background: var(--primary-soft);
  color: var(--primary-dark);
  text-align: center;
  font-size: 26rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.meal-head {
  display: flex;
  align-items: center;
}
.meal-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.meal-meta { flex: 1; }

/* 餐次选择 */
.mealtype-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}
.mealtype-chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #f0f2f1;
  color: var(--sub);
  font-size: 26rpx;
}
.mealtype-active {
  background: var(--primary);
  color: #ffffff;
  font-weight: 600;
}

/* 菜品头部 */
.dish-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.conf-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}
.match-tag { background: var(--primary-soft); color: var(--primary-dark); }
.tag-edited { background: var(--warn-bg); color: var(--warn-text); }
.match-note { margin-top: 8rpx; line-height: 1.6; }

/* 手动改选提示 */
.edited-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}
.reset-link { color: var(--primary-dark); font-size: 24rpx; }

/* 整体摘要 */
.summary-line {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 20rpx;
}
.summary-label { flex-shrink: 0; }
.summary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-dark);
}

/* 源数据每行（一种原食材） */
.row-block {
  margin-top: 24rpx;
  padding-top: 4rpx;
}
.row-block + .row-block {
  border-top: 1rpx solid var(--border);
  padding-top: 24rpx;
}
.row-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.ing-name { font-size: 32rpx; font-weight: 600; }

/* 九项完整指标 */
.metric-table {
  margin-top: 20rpx;
  background: #fafcfb;
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
}
.metric-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 10rpx 0;
}
.metric-name { font-size: 26rpx; }
.metric-num { font-size: 26rpx; color: var(--sub); }
.metric-unit { font-size: 22rpx; }

/* 软硬刻度 */
.metric-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}
.metric-label { font-size: 26rpx; color: var(--muted); flex-shrink: 0; }
.hardness-track {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: #eef1ef;
  overflow: hidden;
}
.hardness-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6fd3a4, #2fae76);
}
.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-dark);
  min-width: 96rpx;
  text-align: right;
}

.metric-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
.metric-pill {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f6f8f7;
  color: var(--sub);
  font-size: 26rpx;
}

.unmatched {
  margin-top: 16rpx;
  color: var(--warn-text);
  background: var(--warn-bg);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

/* 备选面板 */
.alt-toggle {
  margin-top: 20rpx;
  color: var(--primary-dark);
  font-size: 26rpx;
}
.alt-panel {
  margin-top: 16rpx;
  background: #fafcfb;
  border-radius: 16rpx;
  padding: 20rpx;
}
.alt-search {
  background: #ffffff;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
.alt-empty { padding: 16rpx 0; }
.alt-row {
  background: #ffffff;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}
.alt-selected {
  border-color: var(--primary);
  background: var(--primary-soft);
}
.alt-main {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.alt-title { font-size: 28rpx; font-weight: 600; }
.alt-score { font-size: 24rpx; color: var(--primary-dark); }
.alt-sub { margin-top: 4rpx; }
.alt-reason { margin-top: 4rpx; line-height: 1.5; }

.bottom-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}
.bottom-actions .btn { flex: 1; }

/* ---- 逐食材卡片（一种食材一张卡） ---- */
.ing-card { padding-bottom: 24rpx; }
.tag-none { background: var(--warn-bg); color: var(--warn-text); }

/* 数据来自库里的哪道菜 */
.matched-from {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 一种测试模式的一组读数（切割 / 下压） */
.reading-block { margin-top: 20rpx; }
.reading-block + .reading-block {
  border-top: 1rpx solid var(--border);
  padding-top: 20rpx;
}
.reading-head {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

/* 卡片底部的操作链接 */
.ing-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 28rpx;
  margin-top: 20rpx;
}
.alt-toggle-sm {
  color: var(--primary-dark);
  font-size: 26rpx;
}

/* ---- 估重 ---- */
.weight-line {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}
.weight-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-dark);
}
.weight-range { font-size: 24rpx; margin-left: 6rpx; }
.weight-basis {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.plate-note { font-size: 24rpx; margin-left: 12rpx; }
