.estimate-banner {
  background: var(--primary-soft);
  color: var(--primary-dark);
  text-align: center;
  font-size: 26rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.meal-head {
  display: flex;
  align-items: center;
}
.meal-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.meal-meta { flex: 1; }

.dish-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.conf-row {
  display: flex;
  gap: 32rpx;
  margin-top: 8rpx;
}
.total-line {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-top: 20rpx;
}
.total-g {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary-dark);
}

.ing-title {
  margin-bottom: 8rpx;
}
.ing-row {
  padding: 12rpx 0;
}
.ing-main {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.ing-name { font-size: 30rpx; font-weight: 500; }
.ing-est { font-size: 30rpx; font-weight: 600; }
.ing-sub {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 4rpx;
}
.ing-consumed { color: var(--primary-dark); font-size: 24rpx; }

.ratio-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}
.ratio-chip {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: #f0f2f1;
  color: var(--sub);
  font-size: 28rpx;
}
.ratio-active {
  background: var(--primary);
  color: #ffffff;
  font-weight: 600;
}
.consumed-line {
  margin-top: 20rpx;
  color: var(--sub);
}
.consumed-g {
  color: var(--primary-dark);
  font-weight: 700;
  font-size: 32rpx;
}

.limitations {
  margin-top: 24rpx;
  background: #fafcfb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.limit-item {
  line-height: 1.7;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.summary-g {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary-dark);
}
.summary-hint { margin-top: 8rpx; }

.bottom-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}
.bottom-actions .btn { flex: 1; }
