.estimate-banner {
  background: var(--primary-soft);
  color: var(--primary-dark);
  text-align: center;
  font-size: 26rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.meal-head {
  display: flex;
  align-items: center;
}
.meal-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.meal-meta { flex: 1; }

/* 餐次选择 */
.mealtype-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}
.mealtype-chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #f0f2f1;
  color: var(--sub);
  font-size: 26rpx;
}
.mealtype-active {
  background: var(--primary);
  color: #ffffff;
  font-weight: 600;
}

/* 菜品头部 */
.dish-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.conf-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}
.match-tag { background: var(--primary-soft); color: var(--primary-dark); }
.tag-edited { background: var(--warn-bg); color: var(--warn-text); }
.match-note { margin-top: 8rpx; line-height: 1.6; }

/* 食材块 */
.ing-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.ing-name { font-size: 32rpx; font-weight: 600; }

.matched-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}
.matched-title { font-size: 28rpx; color: var(--sub); }
.matched-cooking { flex-shrink: 0; }

/* 软硬刻度 */
.metric-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}
.metric-label { font-size: 26rpx; color: var(--muted); flex-shrink: 0; }
.hardness-track {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: #eef1ef;
  overflow: hidden;
}
.hardness-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6fd3a4, #2fae76);
}
.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-dark);
  min-width: 96rpx;
  text-align: right;
}

.metric-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
.metric-pill {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f6f8f7;
  color: var(--sub);
  font-size: 26rpx;
}

.unmatched {
  margin-top: 16rpx;
  color: var(--warn-text);
  background: var(--warn-bg);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

/* 备选面板 */
.alt-toggle {
  margin-top: 20rpx;
  color: var(--primary-dark);
  font-size: 26rpx;
}
.alt-panel {
  margin-top: 16rpx;
  background: #fafcfb;
  border-radius: 16rpx;
  padding: 20rpx;
}
.alt-search {
  background: #ffffff;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
.alt-empty { padding: 16rpx 0; }
.alt-row {
  background: #ffffff;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}
.alt-selected {
  border-color: var(--primary);
  background: var(--primary-soft);
}
.alt-main {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.alt-title { font-size: 28rpx; font-weight: 600; }
.alt-score { font-size: 24rpx; color: var(--primary-dark); }
.alt-sub { margin-top: 4rpx; }
.alt-reason { margin-top: 4rpx; line-height: 1.5; }

.bottom-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}
.bottom-actions .btn { flex: 1; }
