.analyzing { display: flex; flex-direction: column; align-items: center; padding-top: 56rpx; }
.scan-scene { position: relative; width: 330rpx; height: 330rpx; margin: 24rpx 0 32rpx; overflow: hidden; }
.scan-plate { position: absolute; inset: 15rpx; width: 300rpx; height: 300rpx; }
.scan-orbit { position: absolute; inset: 2rpx; border: 2rpx dashed #cad8ba; border-radius: 50%; animation: scan-orbit 24s linear infinite; }
.scan-line { position: absolute; left: 30rpx; right: 30rpx; height: 3rpx; top: 72rpx; background: #7da582; box-shadow: 0 8rpx 24rpx rgba(36,107,86,0.18); opacity: 0.65; animation: scan-line 3s ease-in-out infinite; }
.scan-spark { position: absolute; top: 40rpx; right: 12rpx; color: #9aaf70; font-size: 44rpx; }
.status-text { font-size: 38rpx; font-weight: 600; text-align: center; }
.status-caption { color: var(--sub); font-size: 28rpx; margin-top: 12rpx; }
.progress-section { width: 100%; margin-top: 40rpx; }
.progress-label { display: flex; align-items: baseline; justify-content: space-between; font-size: 26rpx; color: var(--sub); }
.progress-number { font-size: 38rpx; font-weight: 600; color: var(--primary); }
.progress-number text { font-size: 24rpx; margin-left: 4rpx; }
.progress-track { width: 100%; height: 12rpx; background: #e0e7d9; border-radius: 12rpx; margin-top: 16rpx; overflow: hidden; }
.progress-bar { height: 100%; border-radius: 12rpx; background: linear-gradient(90deg,#9caf78,#246b56); transition: width 450ms ease; }
.steps-card { width: 100%; margin-top: 36rpx; padding: 16rpx 28rpx; }
.step-row { display: flex; align-items: center; padding: 22rpx 0; color: var(--muted); }
.step-mark { width: 46rpx; height: 46rpx; border-radius: 50%; background: #f1f3ed; border: 2rpx solid #dce3d5; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; font-size: 24rpx; flex-shrink: 0; }
.step-label { font-size: 29rpx; }
.step-state { margin-left: auto; padding-left: 14rpx; font-size: 23rpx; }
.is-active .step-mark, .is-done .step-mark { background: var(--primary); border-color: var(--primary); color: #fff; }
.is-active { color: var(--primary); font-weight: 600; }
.is-active .step-mark { animation: active-pulse 2s ease-in-out infinite; }
.is-done { color: var(--text); }
.analyzing-tip { display: flex; align-items: center; gap: 12rpx; color: var(--sub); font-size: 26rpx; margin-top: 12rpx; }
@keyframes scan-line { 50% { transform: translateY(180rpx); opacity: 0.3; } }
@keyframes scan-orbit { to { transform: rotate(360deg); } }
@keyframes active-pulse { 50% { box-shadow: 0 0 0 8rpx rgba(36,107,86,0.1); } }
@media (prefers-reduced-motion: reduce) { .scan-orbit, .scan-line, .is-active .step-mark { animation: none; } .progress-bar { transition: none; } }
