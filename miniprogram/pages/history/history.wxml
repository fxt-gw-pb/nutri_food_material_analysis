<view class="container">
  <!-- 空状态 -->
  <view wx:if="{{loaded && items.length === 0}}" class="empty">
    <view class="empty-icon">🥗</view>
    <view class="empty-text">还没有识别记录</view>
    <view class="btn btn-primary empty-btn" hover-class="btn-hover" bindtap="goUpload">去拍一张</view>
  </view>

  <!-- 列表 -->
  <view
    wx:for="{{items}}"
    wx:key="analysisId"
    class="card record"
    data-id="{{item.analysisId}}"
    bindtap="goDetail"
    bindlongpress="confirmDelete"
  >
    <image wx:if="{{item.imageUrl}}" class="record-img" src="{{item.imageUrl}}" mode="aspectFill" />
    <view wx:else class="record-img thumb-placeholder">🍽️</view>

    <view class="record-body">
      <view class="record-top">
        <text class="record-summary">{{item.dishName}}</text>
        <text class="muted">{{item.dateText}}</text>
      </view>
      <view class="record-stats">
        <text class="tag">{{item.mealTypeText}}</text>
        <text class="sub">{{item.totalCount ? '食材 ' + item.ingredientText : '未识别出食材'}}</text>
      </view>
      <view class="record-texture">
        整体 <text class="record-texture-value">{{item.textureSummary}}</text>
        <text wx:if="{{item.totalG}}" class="record-texture-value"> · 约 {{item.totalG}} g</text>
        <view wx:if="{{item.evaluationStatus === 'pending'}}" class="evaluation-pending">待饭后评估</view>
        <view wx:if="{{item.evaluationStatus === 'completed'}}" class="muted">已评估 · 估算摄入 {{item.totalConsumedG || 0}} g</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loaded && items.length > 0}}" class="muted list-tip">长按记录可删除</view>
</view>
