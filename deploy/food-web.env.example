# 网页版后端环境变量。服务器上放在 /etc/food-web.env（权限 600，仅 root 可读），由 systemd 加载。
# 含密信息（口令、API Key）只写在服务器上，绝不提交到仓库。

HOST=127.0.0.1
PORT=8787
DATA_DIR=/opt/food-web/data
WEB_DIST=/opt/food-web/app/web/dist
# 对外访问地址：参与者链接、Cookie Secure、跨站校验都用它
PUBLIC_ORIGIN=https://example.cn
# 在 Nginx 之后运行，从 X-Real-IP 取客户端地址（口令防暴力破解按 IP 计数）
TRUST_PROXY=1

# 调研员口令：至少 12 位，随机生成后线下告知调研员。改口令后重启服务即可。
RESEARCHER_PASSCODE=

# 千问：与云函数 analyzeMeal 使用同一个 Key；模型保持固定快照，保证科研口径连续
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-max-0902
# 同时进行的识别数
VISION_CONCURRENCY=2

# 首页显示的站点名称，按 ICP 备案的网站名称填写
SITE_TITLE=饮食记录
# 备案通过后填写，首页与登录页底部会显示并链接到工信部备案系统
ICP_NUMBER=
# 公安联网备案号（开通后 30 日内办理），如：京公网安备 11010502000000号
PSB_NUMBER=
