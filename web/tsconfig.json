{
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "miniprogram-api-typings"],
    "typeRoots": ["../node_modules", "../typings"],
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": { "@mp-original/*": ["../miniprogram/*"] }
  },
  "include": ["src/**/*.ts"]
}
