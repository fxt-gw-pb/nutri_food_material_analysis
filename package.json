{
  "name": "nutri-food-material-analysis",
  "version": "2026.11.28",
  "description": "食材识别、估重、饭后摄入评估与质构、营养汇总（微信小程序 + 自建网页版）",
  "private": true,
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "export:data": "node scripts/export-meals.cjs",
    "export:cloud": "node scripts/export-cloud.cjs",
    "export:full": "node scripts/export-full.cjs",
    "export:single": "node scripts/export-single.cjs",
    "build:nutrition": "python3 scripts/build-nutrition-db.py",
    "export:demo": "node scripts/export-meals.cjs --input examples/export/meal_records.json --out exports/demo",
    "web:dev": "node scripts/web/dev.mjs",
    "web:build": "vite build --config web/vite.config.mjs && node server/build.mjs",
    "web:start": "node --env-file-if-exists=.env server/dist/server.cjs",
    "web:admin": "node --env-file-if-exists=.env server/dist/admin.cjs",
    "web:type-check": "tsc -p web/tsconfig.json && tsc -p server/tsconfig.json"
  },
  "devDependencies": {
    "@cloudbase/cli": "3.8.4",
    "@types/node": "24.19.2",
    "@vue/compiler-dom": "3.5.45",
    "esbuild": "0.25.12",
    "miniprogram-api-typings": "^3.12.2",
    "postcss": "8.5.32",
    "qrcode": "1.5.4",
    "typescript": "^5.4.5",
    "vite": "7.3.8",
    "vue": "3.5.45"
  }
}
